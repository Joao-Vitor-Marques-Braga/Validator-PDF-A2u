%!
% PDFA_def.ps - Template de inicialização Ghostscript para conformidade ISO 19005-2 (PDF/A-2u)
/ICCProfile (sRGB_v4_ICC_preference.icc) def

[/_objdef {icc_PDFA} /rawtype /stream /COS pdfmark
[{icc_PDFA}
<<
  /N 3
>> /PUT pdfmark
[{icc_PDFA} ICCProfile (r) file /PUT pdfmark

[
  /OutputConditionIdentifier (sRGB IEC61966-2.1)
  /Info (sRGB IEC61966-2.1)
  /DestOutputProfile {icc_PDFA}
  /RegistryName (http://www.color.org)
  /Subtype /GTS_PDFA1
  /Type /OutputIntent
/OutputIntent pdfmark
